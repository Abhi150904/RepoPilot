[Unit]
Description=RepoPilot production health heartbeat
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=DOCKER_CONFIG=/tmp/repopilot-monitor-docker
Environment=DOCKER_HOST=unix:///var/run/docker.sock
ExecStart=/usr/bin/python3 /opt/repopilot/monitor_production.py
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
