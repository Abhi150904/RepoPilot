Host sandbox-runner
    HostName REPLACE_WITH_RUNNER_PRIVATE_IP
    User sandbox
    IdentityFile /root/.ssh/runner_key
    UserKnownHostsFile /root/.ssh/known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 10
    ServerAliveInterval 10
    ServerAliveCountMax 2
    ForwardAgent no
